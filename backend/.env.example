# Copy to backend/.env (gitignored). Values below are DEV placeholders.
# Prod values live only on the server in /srv/hushroom/backend/.env.

# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3010
REDIS_URL=redis://localhost:6379          # docker-compose overrides to redis://redis:6379
LOG_LEVEL=info

# ── Secrets (REQUIRED — JWT_SECRET is a hard startup requirement) ──────
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-64-hex-chars
SESSION_SECRET=change-me-64-hex-chars
INTERNAL_API_KEY=change-me                # X-Internal-Key for /api/internal/* (Nginx blocks these from the internet)

# ── Email (Lettermint — OTP codes) ─────────────────────────────────────
# Leave LETTERMINT_* empty in dev and set DISABLE_EMAIL_SEND=1.
# NEVER send real OTP mails from tests/dev — inject the code into Redis instead
# (see docs/SELF-HOSTING.md). Lettermint suspends accounts for test traffic.
LETTERMINT_API_TOKEN=
LETTERMINT_FROM_EMAIL=noreply@hushroom.io
DISABLE_EMAIL_SEND=1

# ── LiveKit (voice/video) ──────────────────────────────────────────────
# Dev: docker-compose.dev.yml runs LiveKit in --dev mode with these keys.
# Prod: generate with `docker run --rm livekit/livekit-server:v1.13.5 generate-keys`
#       and put the SAME pair in /srv/hushroom/.env (compose substitution for the livekit container).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-devsecret-devsecret-32chars

# ── Stripe (optional — billing endpoints return 500 "not configured" if unset) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_FIRM_PRICE_ID=
